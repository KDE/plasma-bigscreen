#: main.cpp:29
#, kde-format
msgid "Redirect links to QR codes or KDE Connect devices"
msgstr "Omdiriger lenkjer til QR-kodar eller KDE Connect-einingar"

#: main.cpp:31
#, kde-format
msgid "© 2026 Plasma developers"
