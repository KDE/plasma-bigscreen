#: contents/logout/Logout.qml:174
msgid ""
"One other user is currently logged in. If the computer is shut down or "
"restarted, that user may lose work."
msgid_plural ""
"%1 other users are currently logged in. If the computer is shut down or "
"restarted, those users may lose work."
msgstr[0] ""
"Тренутно је пријављен још %1 корисник. Ако се рачунар угаси или поново "
"покрене, они могу изгубити свој рад."
msgstr[1] ""
"Тренутно су пријављена још %1 корисника. Ако се рачунар угаси или поново "
"покрене, они могу изгубити свој рад."
msgstr[2] ""
"Тренутно је пријављено још %1 корисника. Ако се рачунар угаси или поново "
"покрене, они могу изгубити свој рад."
msgstr[3] ""
"Тренутно је пријављен још један корисник. Ако се рачунар угаси или поново "
"покрене, тај корисник може изгубити свој рад."

#: contents/logout/Logout.qml:191
msgid "When restarted, the computer will enter UEFI firmware settings."
msgstr "По поновном покретању, рачунар ће ући у поставке UEFI фирмвера."

#: contents/logout/Logout.qml:193
msgid "When restarted, the computer will enter the firmware setup screen."
msgstr "По поновном покретању, рачунар ће ући у екран за подешавање фирмвера."

#: contents/logout/Logout.qml:208
msgid "When restarted, the computer will enter the boot loader menu."
msgstr "По поновном покретању, рачунар ће ући у мени подизног учитавача."

#: contents/logout/Logout.qml:221
msgctxt "%1 is a boot loader entry"
msgid "When restarted, the computer will switch to %1."
msgstr "По поновном покретању, рачунар ће прећи на %1."

