#: ui/GameControllerSidebar.qml:36
#, kde-format
msgid "System navigation"
msgstr "Järjestelmänavigointi"

#: ui/GameControllerSidebar.qml:51
#, kde-format
msgid "START button when suppressed"
msgstr "KÄYNNISTYSpainike estotilassa"

#: ui/GameControllerSidebar.qml:52
#, kde-format
msgid ""
"Handle the START button even when input is suppressed (may conflict with "
"some apps)"
msgstr ""
"Reagoi KÄYNNISTYSpainikkeeseen myös syötteen ollessa estetty (voi aiheuttaa "
"ristiriidan sovellusten kanssa)"

#: ui/main.qml:17
#, kde-format
msgid "Input"
msgstr "Syöte"

#: ui/main.qml:105
#, kde-format
msgid "Input daemon is not running"
msgstr "Syötepalvelu ei ole käynnissä"

#: ui/main.qml:106
#, kde-format
msgid ""
"Controller and remote settings are only available when plasma-bigscreen-"
"inputhandler is running"
msgstr ""
"Ohjain- ja kaukosäädinasetukset ovat käytettävissä vain, kun plasma-"
"bigscreen-inputhandler on käynnissä"

#: ui/main.qml:112
#, kde-format
msgid "System Navigation"
msgstr "Järjestelmänavigointi"

#: ui/main.qml:113
#, kde-format
msgid ""
"Navigate the system interface with connected controllers/remotes (apps can "
"always still use them directly)"
msgstr ""
"Liiku käyttöliittymässä järjestelmään kytketyllä ohjaimella tai "
"kaukosäätimellä (sovellukset voivat silti käyttää sitä suoraan)"

#: ui/main.qml:130
#, kde-format
msgid "TV remote"
msgstr "TV-kaukosäädin"

#: ui/main.qml:131
#, kde-format
msgid "Navigate the system interface with the connected TV remote (CEC)"
msgstr ""
"Liiku käyttöliittymässä järjestelmään kytketyllä TV-kaukosäätimellä (CEC)"

#: ui/main.qml:150
#, kde-format
msgid "Game Controllers"
msgstr "Peliohjaimet"

#: ui/main.qml:160
#, kde-format
msgid "Game controllers"
msgstr "Peliohjaimet"

#: ui/main.qml:161
#, kde-format
msgid "Use connected game controllers for system navigation"
msgstr "Liiku järjestelmään kytketyllä peliohjaimella"

#: ui/main.qml:180
#, kde-format
msgid "Automatic input suppression"
msgstr "Automaattinen syötteen esto"

#: ui/main.qml:181
#, kde-format
msgid "Stop controller navigation while another app is using a controller"
msgstr "Pysäytä ohjainnavigointi toisen sovelluksen käyttäessä ohjainta"

#: ui/main.qml:201
#, kde-format
msgid "No controllers connected"
msgstr "Ei kytkettyjä ohjaimia"

#: ui/main.qml:202
#, kde-format
msgid "Connect a game controller"
msgstr "Kytke peliohjain"
