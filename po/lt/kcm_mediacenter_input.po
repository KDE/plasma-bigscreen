#, kde-format
msgid "START button when suppressed"
msgstr "„START“ mygtukas, kai nuslopintas"

#: ui/GameControllerSidebar.qml:52
#, kde-format
msgid ""
"Handle the START button even when input is suppressed (may conflict with "
"some apps)"
msgstr ""
"Apdoroti „START“ mygtuką net tada, kai įvedimas nuslopintas (gali "
"konfliktuoti su tam tikromis programomis)"

#: ui/main.qml:17
#, kde-format
msgid "Input"
msgstr "Įvedimas"

#: ui/main.qml:105
#, kde-format
msgid "Input daemon is not running"
msgstr "Įvedimo tarnyba neveikia"

#: ui/main.qml:106
#, kde-format
msgid ""
"Controller and remote settings are only available when plasma-bigscreen-"
"inputhandler is running"
msgstr ""
"Valdiklio ir nuotolinio valdymo pulto nuostatos yra prieinamos tik tada, kai "
"veikia plasma-bigscreen-inputhandler"

#: ui/main.qml:112
#, kde-format
msgid "System Navigation"
msgstr "Naršymas sistemoje"

#: ui/main.qml:113
#, kde-format
msgid ""
"Navigate the system interface with connected controllers/remotes (apps can "
