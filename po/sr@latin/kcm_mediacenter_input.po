#: ui/GameControllerSidebar.qml:36
#, kde-format
msgid "System navigation"
msgstr "Navigacija kroz sistem"

#: ui/GameControllerSidebar.qml:51
#, kde-format
msgid "START button when suppressed"
msgstr "Dugme START tokom suzbijanja"

#: ui/GameControllerSidebar.qml:52
#, kde-format
msgid ""
"Handle the START button even when input is suppressed (may conflict with "
"some apps)"
msgstr ""
"Obrađuj dugme START i kada je unos suzbijen (može biti u sukobu sa nekim "
"programima)"

#: ui/main.qml:17
#, kde-format
msgid "Input"
msgstr "Ulaz"

#: ui/main.qml:105
#, kde-format
msgid "Input daemon is not running"
msgstr "Demon unosa nije pokrenut"

#: ui/main.qml:106
#, kde-format
msgid ""
"Controller and remote settings are only available when plasma-bigscreen-"
"inputhandler is running"
msgstr ""
"Postavke kontrolora i daljinskog upravljača dostupne su samo kada radi "
"rukovalac unosom Plasme za veliki ekran (plasma-bigscreen-inputhandler)"

#: ui/main.qml:112
#, kde-format
msgid "System Navigation"
msgstr "Navigacija kroz sistem"

#: ui/main.qml:113
#, kde-format
msgid ""
"Navigate the system interface with connected controllers/remotes (apps can "
"always still use them directly)"
msgstr ""
"Kreći se kroz sistemsko sučelje povezanim kontrolorima i daljinskim "
"upravljačima (programi ih i dalje mogu koristiti neposredno)"

#: ui/main.qml:130
#, kde-format
msgid "TV remote"
msgstr "Daljinski upravljač televizora"

#: ui/main.qml:131
#, kde-format
msgid "Navigate the system interface with the connected TV remote (CEC)"
msgstr ""
"Kreći se kroz sistemsko sučelje povezanim daljinskim upravljačem televizora "
"(CEC)"

#: ui/main.qml:151
#, kde-format
msgid "TV HDMI port (CEC)"
msgstr "HDMI priključak televizora (CEC)"

#: ui/main.qml:156
#, kde-format
msgid "Automatic"
msgstr "automatski"

#: ui/main.qml:158
#, kde-format
msgid "HDMI %1"
msgstr "HDMI %1"

#: ui/main.qml:176
#, kde-format
msgid "Game Controllers"
msgstr "Kontrolori za igre"

#: ui/main.qml:186
#, kde-format
msgid "Game controllers"
msgstr "Kontrolori za igre"

#: ui/main.qml:187
#, kde-format
msgid "Use connected game controllers for system navigation"
msgstr "Koristi povezane kontrolore za igre za navigaciju kroz sistem"

#: ui/main.qml:206
#, kde-format
msgid "Automatic input suppression"
msgstr "Automatsko suzbijanje unosa"

#: ui/main.qml:207
#, kde-format
msgid "Stop controller navigation while another app is using a controller"
msgstr ""
"Obustavi navigaciju kontrolorom dok neki drugi program koristi kontrolor"

#: ui/main.qml:227
#, kde-format
msgid "No controllers connected"
msgstr "Nema povezanih kontrolora"

#: ui/main.qml:228
#, kde-format
msgid "Connect a game controller"
msgstr "Povežite kontrolor za igre"
