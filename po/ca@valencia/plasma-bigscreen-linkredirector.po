#: main.cpp:27
#, kde-format
msgid "Plasma Bigscreen Link Redirector"
msgstr "Redirector d'enllaços de Plasma Bigscreen"

#: main.cpp:29
#, kde-format
msgid "Redirect links to QR codes or KDE Connect devices"
msgstr ""
"Redirigix els enllaços cap a un codis QR o a dispositius de KDE Connect"

#: main.cpp:31
#, kde-format
msgid "© 2026 Plasma developers"
msgstr "© 2026 Els desenvolupadors de Plasma"

#: Main.qml:66
#, kde-format
msgid "Choose a device to send the URL to:"
msgstr "Trieu un dispositiu a on enviar l'URL:"

#: Main.qml:103
#, kde-format
msgctxt "%1 is the device, %2 is the error message returned through dbus"
msgid "Failed to send URL to %1: %2"
msgstr "Ha fallat mentre s'enviava l'URL cap a %1: %2"

#: Main.qml:114
#, kde-format
msgctxt "Shown in placeholder message if no devices are reachable"
msgid "No connected devices"
msgstr "No hi ha cap dispositiu connectat"

#: Main.qml:115
#, kde-format
msgctxt "Explanation of \"No connected devices\" placeholder"
msgid "Connect a device or check KDE Connect settings"
msgstr "Connecteu a un dispositiu o comproveu la configuració de KDE Connect"

#: Main.qml:138
#, kde-format
msgid "Scan the QR code below with a supported device:"
msgstr "Escanegeu el codi QR a continuació amb un dispositiu compatible:"

#: Main.qml:158
#, kde-format
msgid "Open in browser"
msgstr "Obri en un navegador"
