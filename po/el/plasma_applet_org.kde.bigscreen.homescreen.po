#: contents/ui/FavoritesManager.qml:20 contents/ui/indicators/Favorites.qml:17
#, kde-format
msgid "Edit Home Screen"
msgstr "Επεξεργασία αρχικής οθόνης"

#: contents/ui/FavoritesManager.qml:144
#: contents/ui/launcher/LauncherHome.qml:189
#, kde-format
msgid "Favorites"
msgstr "Αγαπημένα"

#: contents/ui/FavoritesManager.qml:144 contents/ui/FavoritesManager.qml:319
#, kde-format
msgid "Launcher Sections"
msgstr "Ενότητες εκκίνησης εφαρμογών"

#: contents/ui/FavoritesManager.qml:144 contents/ui/FavoritesManager.qml:410
#, kde-format
msgid "Hidden Apps"
msgstr "Κρυφές εφαρμογές"

#: contents/ui/FavoritesManager.qml:206
#, kde-format
msgid "Change Favorites Order"
msgstr "Αλλαγή σειράς αγαπημένων"

#: contents/ui/FavoritesManager.qml:216
#, kde-format
msgid ""
"To change the order of the favorites, hold the select button on a favorite "
"on the home screen and choose Move."
msgstr ""
"Για να αλλάξετε τη σειρά των αγαπημένων, κρατήστε πατημένο το κουμπί "
"επιλογής σε ένα αγαπημένο στην αρχική οθόνη και επιλέξτε «Μετακίνηση»."

#: contents/ui/FavoritesManager.qml:248
#, kde-format
msgid "Add Favorites"
msgstr "Προσθήκη αγαπημένων"

#: contents/ui/FavoritesManager.qml:288
#, kde-format
msgid "Remove Favorites"
msgstr "Αφαίρεση αγαπημένων"

#: contents/ui/FavoritesManager.qml:333
#, kde-format
msgid "Show Recent"
msgstr "Εμφάνιση πρόσφατων εφαρμογών"

#: contents/ui/FavoritesManager.qml:334
#, kde-format
msgid "Recently launched applications appear in a row on the home screen"
msgstr ""
"Οι εφαρμογές που ανοίξατε πρόσφατα εμφανίζονται σε μια σειρά στην αρχική "
"οθόνη"

#: contents/ui/FavoritesManager.qml:349
#, kde-format
msgid "Show Applications"
msgstr "Εμφάνιση εφαρμογών"

#: contents/ui/FavoritesManager.qml:350
#, kde-format
msgid "Non-game applications appear in a row on the home screen"
msgstr ""
"Οι εφαρμογές εκτός παιχνιδιών εμφανίζονται σε μια σειρά στην αρχική οθόνη"

#: contents/ui/FavoritesManager.qml:366
#, kde-format
msgid "Show Games"
msgstr "Εμφάνιση παιχνιδιών"

#: contents/ui/FavoritesManager.qml:367
#, kde-format
msgid "Applications in the Game category appear in a row on the home screen"
msgstr ""
"Οι εφαρμογές της κατηγορίας «Παιχνίδια» εμφανίζονται σε μια σειρά στην "
"αρχική οθόνη"

