msgstr "Το %1 προστέθηκε στα αγαπημένα"

#: contents/ui/launcher/AppOptionsDrawer.qml:87
#, kde-format
msgid "Removed %1 from Favorites"
msgstr "Το %1 αφαιρέθηκε από τα αγαπημένα"

#: contents/ui/launcher/AppOptionsDrawer.qml:92
#, kde-format
msgid "%1 hidden. Show it again from Edit Home Screen."
msgstr ""
"Το %1 αποκρύφτηκε. Μπορείτε να το εμφανίσετε ξανά από την «Επεξεργασία "
"αρχικής οθόνης»."

#: contents/ui/launcher/AppOptionsDrawer.qml:111
#, kde-format
msgid "Move"
msgstr "Μετακίνηση"

#: contents/ui/launcher/AppOptionsDrawer.qml:114
