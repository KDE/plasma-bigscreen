#: ui/GameControllerSidebar.qml:36
#, kde-format
msgid "System navigation"
msgstr "Навигация по системе"

#: ui/GameControllerSidebar.qml:51
#, kde-format
msgid "START button when suppressed"
msgstr "Кнопка START при блокировке ввода"

#: ui/GameControllerSidebar.qml:52
#, kde-format
msgid ""
"Handle the START button even when input is suppressed (may conflict with "
"some apps)"
msgstr ""
"Обрабатывать кнопку START, даже если ввод заблокирован (возможен конфликт с "
"некоторыми приложениями)"

#: ui/main.qml:17
#, kde-format
msgid "Input"
msgstr "Ввод"

#: ui/main.qml:105
#, kde-format
msgid "Input daemon is not running"
msgstr "Служба ввода не запущена"

#: ui/main.qml:106
#, kde-format
msgid ""
"Controller and remote settings are only available when plasma-bigscreen-"
"inputhandler is running"
msgstr ""
"Параметры контроллера и пульта доступны только при запущенном plasma-"
"bigscreen-inputhandler"

#: ui/main.qml:112
#, kde-format
msgid "System Navigation"
msgstr "Навигация по системе"

#: ui/main.qml:113
#, kde-format
msgid ""
"Navigate the system interface with connected controllers/remotes (apps can "
"always still use them directly)"
msgstr ""
"Навигация по интерфейсу системы с помощью подключённых контроллеров и "
"пультов (приложения по-прежнему могут использовать их напрямую)"

#: ui/main.qml:130
#, kde-format
msgid "TV remote"
msgstr "Пульт телевизора"

#: ui/main.qml:131
#, kde-format
msgid "Navigate the system interface with the connected TV remote (CEC)"
msgstr ""
"Навигация по интерфейсу системы с помощью подключённого пульта телевизора "
"(CEC)"

#: ui/main.qml:151
#, kde-format
msgid "TV HDMI port (CEC)"
msgstr "Порт HDMI телевизора (CEC)"

#: ui/main.qml:156
#, kde-format
msgid "Automatic"
msgstr "Автоматически"

#: ui/main.qml:158
#, kde-format
msgid "HDMI %1"
msgstr "HDMI %1"

#: ui/main.qml:176
#, kde-format
msgid "Game Controllers"
msgstr "Игровые контроллеры"

#: ui/main.qml:186
#, kde-format
msgid "Game controllers"
msgstr "Игровые контроллеры"

#: ui/main.qml:187
#, kde-format
msgid "Use connected game controllers for system navigation"
msgstr "Использовать подключённые игровые контроллеры для навигации по системе"

#: ui/main.qml:206
#, kde-format
msgid "Automatic input suppression"
msgstr "Автоматическая блокировка ввода"

#: ui/main.qml:207
#, kde-format
msgid "Stop controller navigation while another app is using a controller"
msgstr ""
"Останавливать навигацию с помощью контроллера, пока другое приложение "
"использует контроллер"

#: ui/main.qml:227
#, kde-format
msgid "No controllers connected"
msgstr "Нет подключённых контроллеров"

#: ui/main.qml:228
#, kde-format
msgid "Connect a game controller"
msgstr "Подключите игровой контроллер"
